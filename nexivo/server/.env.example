# --- Runtime ---
NODE_ENV=development
PORT=4000

# Local Docker MySQL. For TiDB Cloud use:
# mysql://USER:PASS@HOST:4000/nexivo?sslaccept=strict
DATABASE_URL="mysql://root:rootpass@localhost:3306/nexivo"

# 32+ random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
JWT_EXPIRES_IN=7d

# Where the React app runs (CORS origin) and the public site URL (sitemap, canonical)
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# Seeded accounts (used only by prisma/seed.ts)
ADMIN_NAME="Aarav Mehta"
ADMIN_EMAIL=admin@nexivo.dev
ADMIN_PASSWORD=Admin@12345
EDITOR_NAME="Sara Kapoor"
EDITOR_EMAIL=editor@nexivo.dev
EDITOR_PASSWORD=Editor@12345

# Number of proxy hops in front of Express (Render = 1, Vercel rewrite -> Render = 2). 0 locally.
TRUST_PROXY=0
